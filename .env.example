# Пример переменных окружения. Скопируйте значения в свою оболочку —
# приложение не читает .env автоматически.

# --- Пути -------------------------------------------------------------------
# VECTOR_DATA_DIR=C:/vector/data
# VECTOR_DB=C:/vector/data/vector.db
# VECTOR_MODELS_DIR=C:/vector/data/models
# FFMPEG_PATH=C:/vector/tools/ffmpeg/bin/ffmpeg.exe
# FFPROBE_PATH=C:/vector/tools/ffmpeg/bin/ffprobe.exe

# --- Ограничения загрузки ---------------------------------------------------
MAX_UPLOAD_MB=2048
MAX_DURATION_SEC=14400

# --- Распознавание речи -----------------------------------------------------
# auto | whisper | mock
ASR_BACKEND=auto
WHISPER_MODEL=small
WHISPER_COMPUTE=int8
# auto — определять язык автоматически, ru/en/… — принудительно
WHISPER_LANGUAGE=auto
ASR_CPU_THREADS=4

# --- Эмбеддинги -------------------------------------------------------------
# auto | model2vec | hashing | openai
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=minishlab/potion-multilingual-128M
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- LLM для конспекта и Q&A (опционально) ---------------------------------
LLM_ENABLED=0
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# LLM_TIMEOUT=90

# --- Импорт по ссылке ------------------------------------------------------
# VK Видео, Rutube, Dailymotion и прямые MP4/WebM работают без настроек.
# YouTube/Vimeo с IP дата-центра требуют cookies (Netscape-формат).
# YTDLP_COOKIES_FILE=C:/vector/cookies.txt
# YTDLP_COOKIES_B64=

# --- Поиск и логи -----------------------------------------------------------
SEARCH_MIN_SCORE=0.16
SEARCH_DEFAULT_LIMIT=12
LOG_LEVEL=INFO
